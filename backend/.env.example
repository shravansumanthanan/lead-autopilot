# =============================================================================
# Lead Autopilot — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ── OpenRouter AI (Required) ──────────────────────────────────────────────────
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=qwen/qwen3-235b-a22b

# ── Database ───────────────────────────────────────────────────────────────────
# Development (default): SQLite — simple, zero-config, single-process only.
DATABASE_URL=sqlite:///./leads.db
#
# Production (recommended): PostgreSQL — required for multi-worker Celery
# deployments to prevent write-lock contention.
# DATABASE_URL=postgresql://user:password@localhost:5432/lead_autopilot

# ── Email / SMTP (Required for email delivery) ────────────────────────────────
# Use a Gmail App Password — NOT your regular Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Lead Autopilot

# ── Business Branding (Shown on PDF cover page) ───────────────────────────────
BUSINESS_NAME=Your Company Name
BUSINESS_TAGLINE=Data-Driven Insights
BUSINESS_WEBSITE=https://yourcompany.com
BUSINESS_EMAIL=contact@yourcompany.com
BUSINESS_PHONE=+1 (555) 123-4567

# ── Optional: Firecrawl (Better JS-rendered site scraping) ───────────────────
# Get key at: https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-your-key-here

# ── Optional: Serper.dev (Google Search enrichment) ──────────────────────────
# Get key at: https://serper.dev
# SERPER_API_KEY=your-serper-key-here

# ── Optional: Google Sheets Logging (Bonus) ───────────────────────────────────
# Service account JSON from Google Cloud Console
# GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json
# GOOGLE_SHEET_NAME=Lead Autopilot Tracker

# ── Optional: Google Drive PDF Archival (Bonus) ───────────────────────────────
# GOOGLE_DRIVE_CREDENTIALS_FILE=service_account.json
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# ── Optional: Slack & CRM Webhooks ────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# ── Internal ──────────────────────────────────────────────────────────────────
DEFAULT_TIMEOUT=30.0
